{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "inv2_ponte_conteggio_negozio",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "registra_conteggio": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "inv2PonteConteggio",
            "args": {
              "entita": "RilevazioneInventario",
              "rilevazione_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Registra il conteggio",
            "description": "Movimento di tipo conteggio"
          }
        }
      }
    ]
  },
  "description": "Copia ogni nuovo conteggio del form inventario attuale nel registro di Inventario 2.0 (solo store in affiancamento)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "RilevazioneInventario"
    }
  },
  "name": "Inv2 Ponte Conteggio Negozio"
}