{
  "name": "Salva PDF Contratto Firmato",
  "description": "Genera e salva automaticamente il PDF quando un contratto viene firmato",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Contratto"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "salva_pdf_contratto_firmato",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "saveContractPDFToBase44",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
