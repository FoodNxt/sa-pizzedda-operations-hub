{
  "name": "Inv2 Ricevimento Ordine",
  "description": "Quando un ordine fornitore \u00e8 completato, registra i ricevimenti nel registro di Inventario 2.0",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "OrdineFornitore",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"completato\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "inv2_ricevimento_ordine",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "registra_ricevimento": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "inv2RicevimentoOrdine",
            "args": {
              "ordine_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Registra i ricevimenti",
            "description": "Una riga per prodotto ricevuto"
          }
        }
      }
    ]
  }
}