{
  "name": "SessioneConteggio",
  "type": "object",
  "properties": {
    "ubicazione_key": {
      "type": "string",
      "description": "ID store per un negozio, 'lab:' + ID store per il laboratorio"
    },
    "store_id": {
      "type": "string"
    },
    "ubicazione_tipo": {
      "type": "string",
      "enum": [
        "negozio",
        "laboratorio"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "data": {
      "type": "string",
      "format": "date-time"
    },
    "operatore_email": {
      "type": "string"
    },
    "operatore_nome": {
      "type": "string"
    },
    "turno_id": {
      "type": "string"
    },
    "prodotti_previsti": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "item_id dei prodotti da contare"
    },
    "prodotti_contati": {
      "type": "number",
      "default": 0
    },
    "completata": {
      "type": "boolean",
      "default": false
    },
    "verifica": {
      "type": "boolean",
      "default": false,
      "description": "Conteggio di verifica dell'admin: non vale come inventario della sera"
    },
    "stato": {
      "type": "string",
      "enum": [
        "bozza",
        "chiusa",
        "scartata"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "description": "Solo per il conteggio di verifica. bozza = righe salvate ma non ancora movimenti, chiusa = verifica salvata, scartata = bozza buttata"
    },
    "righe_bozza": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "quantita": {
            "type": "number"
          },
          "ora": {
            "type": "string",
            "format": "date-time",
            "description": "Quando la riga \u00e8 stata salvata"
          }
        }
      },
      "description": "Righe del conteggio di verifica: diventano movimenti solo con Salva verifica"
    }
  },
  "required": [
    "ubicazione_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}