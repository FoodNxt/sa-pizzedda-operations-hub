{
  "name": "GiacenzaStimata",
  "type": "object",
  "properties": {
    "ubicazione_key": {
      "type": "string",
      "description": "ID store per un negozio, 'lab:' + ID store per il laboratorio"
    },
    "store_id": {
      "type": "string"
    },
    "ubicazione_tipo": {
      "type": "string",
      "enum": [
        "negozio",
        "laboratorio"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "item_tipo": {
      "type": "string",
      "enum": [
        "materia_prima",
        "semilavorato"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "item_id": {
      "type": "string"
    },
    "item_nome": {
      "type": "string"
    },
    "unita": {
      "type": "string"
    },
    "ultimo_conteggio_valore": {
      "type": "number"
    },
    "ultimo_conteggio_data": {
      "type": "string",
      "format": "date-time"
    },
    "unita_sospetta_conteggi": {
      "type": "number",
      "description": "Conteggi degli ultimi 28 giorni lasciati fuori perch\u00e9 in unit\u00e0 sospetta"
    },
    "unita_sospetta_valore": {
      "type": "number",
      "description": "Valore originale dell'ultimo conteggio in unit\u00e0 sospetta"
    },
    "unita_sospetta_data": {
      "type": "string",
      "format": "date-time",
      "description": "Data dell'ultimo conteggio in unit\u00e0 sospetta"
    },
    "giacenza_stimata": {
      "type": "number"
    },
    "consumo_medio_giorno": {
      "type": "number"
    },
    "consumo_teorico_giorno": {
      "type": "number",
      "description": "Consumo al giorno dalle vendite del POS per ricetta, media degli ultimi 28 giorni"
    },
    "fattore_correzione": {
      "type": "number",
      "description": "Consumo da conteggi diviso consumo teorico sullo stesso periodo, tra 0,7 e 1,5"
    },
    "fonte_consumo": {
      "type": "string",
      "enum": [
        "vendite",
        "conteggi",
        "ricevimenti",
        "nessun_dato"
      ],
      "enumColors": [
        "green",
        "blue",
        "gray",
        "red"
      ],
      "description": "Da dove viene il consumo medio al giorno"
    },
    "uscite_registrate_giorno": {
      "type": "number"
    },
    "intervalli_negativi": {
      "type": "number",
      "description": "Intervalli tra due conteggi con residuo negativo (diagnostica)"
    },
    "intervalli_totali": {
      "type": "number",
      "description": "Intervalli tra due conteggi considerati (diagnostica)"
    },
    "giorni_copertura": {
      "type": "number"
    },
    "affidabilita": {
      "type": "string",
      "enum": [
        "ok",
        "da_verificare",
        "nessun_dato"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ]
    },
    "scarto_ultimo_conteggio_pct": {
      "type": "number"
    },
    "prossimo_conteggio_data": {
      "type": "string",
      "format": "date"
    },
    "prossimo_conteggio_motivo": {
      "type": "string"
    },
    "priorita": {
      "type": "number"
    },
    "aggiornato_il": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "ubicazione_key",
    "item_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}