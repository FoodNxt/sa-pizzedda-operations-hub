{
  "name": "OrderArrivalAlertConfig",
  "type": "object",
  "properties": {
    "email_destinatario": {
      "type": "string",
      "description": "Email a cui inviare la notifica di possibile arrivo ordine non segnato"
    },
    "attivo": {
      "type": "boolean",
      "default": true,
      "description": "Se le notifiche email sono attive"
    }
  },
  "required": [
    "email_destinatario"
  ]
}