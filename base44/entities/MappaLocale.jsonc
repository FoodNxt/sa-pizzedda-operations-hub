{
  "name": "MappaLocale",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID dello store"
    },
    "store_name": {
      "type": "string",
      "description": "Nome dello store"
    },
    "background_image": {
      "type": "string",
      "description": "URL dell'immagine di sfondo (planimetria)"
    },
    "attrezzature_posizioni": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attrezzatura_id": {
            "type": "string"
          },
          "attrezzatura_nome": {
            "type": "string"
          },
          "icona_url": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "description": "Posizione X (percentuale 0-100)"
          },
          "y": {
            "type": "number",
            "description": "Posizione Y (percentuale 0-100)"
          },
          "width": {
            "type": "number",
            "description": "Larghezza (percentuale)"
          },
          "height": {
            "type": "number",
            "description": "Altezza (percentuale)"
          }
        }
      },
      "description": "Posizioni e dimensioni delle attrezzature sulla mappa"
    },
    "storage_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID univoco dell'area"
          },
          "nome": {
            "type": "string",
            "description": "Nome dell'area di stoccaggio"
          },
          "x": {
            "type": "number",
            "description": "Posizione X (percentuale 0-100)"
          },
          "y": {
            "type": "number",
            "description": "Posizione Y (percentuale 0-100)"
          },
          "width": {
            "type": "number",
            "description": "Larghezza (percentuale)"
          },
          "height": {
            "type": "number",
            "description": "Altezza (percentuale)"
          },
          "colore": {
            "type": "string",
            "description": "Colore dell'area (hex)"
          },
          "rotation": {
            "type": "number",
            "description": "Rotazione in gradi"
          }
        }
      },
      "description": "Aree di stoccaggio posizionate sulla mappa"
    },
    "linee": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x1": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "y2": {
            "type": "number"
          }
        }
      },
      "description": "Linee disegnate sulla mappa (pareti, divisori)"
    },
    "note": {
      "type": "string",
      "description": "Note aggiuntive sulla mappa"
    }
  },
  "required": [
    "store_id"
  ]
}