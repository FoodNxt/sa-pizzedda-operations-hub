{
  "name": "ConfigInventario2",
  "type": "object",
  "properties": {
    "modalita_per_store": {
      "type": "object",
      "default": {},
      "description": "Modalit\u00e0 Inventario 2.0 per store {store_id: 'spento' | 'affiancamento' | 'attivo'}. Store assente = spento"
    },
    "affiancamento_dal_per_store": {
      "type": "object",
      "default": {},
      "description": "Data di inizio dell'affiancamento per store {store_id: 'YYYY-MM-DD'}"
    },
    "inizio_storico_per_store": {
      "type": "object",
      "default": {},
      "description": "Giorno da cui parte lo storico per store {store_id: 'YYYY-MM-DD'}: conteggi, movimenti e vendite precedenti non contano nel ricalcolo e nel confronto consumi"
    },
    "lab_store_id": {
      "type": "string",
      "default": "6908b4f284cb01bc8402b4ee",
      "description": "ID dello store che ospita il laboratorio (default Lanino)"
    },
    "basi_ricetta_id": {
      "type": "string",
      "description": "ID della ricetta semilavorato 'Basi'"
    },
    "ricette_escluse_dal_consumo_negozio": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "6924a44b3efb16f236fbfcca"
      ],
      "description": "ID delle ricette che non contano nel consumo teorico dei negozi (default Pallina: le basi arrivano dal laboratorio)"
    },
    "limite_voci_sera": {
      "type": "number",
      "default": 15,
      "description": "Numero massimo di voci da contare per sera"
    },
    "intervallo_max_giorni_per_categoria": {
      "type": "object",
      "default": {
        "Ingredienti pronti": 7,
        "Ortofrutta": 7,
        "Ingredienti base": 14,
        "Bevande": 14,
        "Dolci": 14,
        "Angolo di Sardegna": 14,
        "Packaging": 30,
        "Consumabili": 30,
        "Pulizia": 30,
        "semilavorato": 7
      },
      "description": "Intervallo massimo in giorni tra due conteggi, per categoria"
    },
    "giorni_sicurezza_per_categoria": {
      "type": "object",
      "default": {
        "Ortofrutta": 1,
        "semilavorato": 1,
        "Ingredienti base": 3,
        "Ingredienti pronti": 3,
        "Bevande": 3,
        "Dolci": 3,
        "Angolo di Sardegna": 3,
        "Packaging": 3,
        "Consumabili": 3,
        "Pulizia": 3
      },
      "description": "Giorni di sicurezza aggiunti ai giorni di attesa nel minimo suggerito, per categoria. Il valore sul prodotto, se presente, lo sostituisce"
    },
    "soglia_affidabilita": {
      "type": "number",
      "default": 0.3,
      "description": "Soglia di scarto oltre la quale la giacenza stimata \u00e8 da verificare"
    },
    "negozi_pos": {
      "type": "object",
      "default": {},
      "description": "Abbinamento dei punti vendita del POS agli store {pos_location_id: store_id}"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}