{
  "name": "P2PFeedbackResponse",
  "type": "object",
  "properties": {
    "reviewer_id": {
      "type": "string",
      "description": "ID dell'utente che compila"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Nome dell'utente che compila"
    },
    "reviewed_id": {
      "type": "string",
      "description": "ID dell'utente valutato"
    },
    "reviewed_name": {
      "type": "string",
      "description": "Nome dell'utente valutato"
    },
    "week_start_date": {
      "type": "string",
      "format": "date",
      "description": "Data inizio settimana di riferimento"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric_id": {
            "type": "string"
          },
          "metric_name": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          }
        }
      },
      "description": "Punteggi delle metriche (1-5)"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data di invio"
    }
  },
  "required": [
    "reviewer_id",
    "reviewed_id",
    "week_start_date",
    "responses"
  ]
}