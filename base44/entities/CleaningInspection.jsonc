{
  "name": "CleaningInspection",
  "type": "object",
  "properties": {
    "store_name": {
      "type": "string",
      "description": "Nome del locale ispezionato"
    },
    "store_id": {
      "type": "string",
      "description": "Reference to Store entity"
    },
    "inspection_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data e ora dell'ispezione"
    },
    "inspector_name": {
      "type": "string",
